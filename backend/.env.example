# ============================================================
# Game_C 后端环境变量示例
# 复制为 .env 后按需修改；所有变量均有默认值，未设置也可启动（SQLite 开发态）。
# ============================================================

# --- 运行 ---
GC_DEBUG=false
GC_LOG_LEVEL=INFO
# REST 统一前缀（留空 = 无前缀；设为 /api 时所有路由前缀 /api）
GC_API_PREFIX=

# --- 数据库 ---
# 开发默认：SQLite（stdlib，无需额外驱动）
GC_DATABASE_URL=sqlite:///./game_c.db
# 生产（多用户）：PostgreSQL
# GC_DATABASE_URL=postgresql+psycopg://gamec:gamec@localhost:5432/game_c

# --- 安全 ---
# API Key 加密密钥的来源，三选一，按优先级：
#   1. GC_FERNET_KEY   直接给一把 Fernet 密钥（32 字节 urlsafe base64）；
#   2. GC_SECRET_KEY   改掉默认值后由它派生；
#   3. 都不配          首次启动自动生成 GC_FERNET_KEY_FILE 并落盘（自托管默认，每机独立）。
# 无论哪种：换了密钥就解不开库里已存的 Key；备份数据库时把密钥（文件或 .env）一起备份。
GC_SECRET_KEY=dev-insecure-change-me
# GC_FERNET_KEY=
GC_FERNET_KEY_FILE=./fernet.key

# 登录 opaque token 有效期（天）
GC_TOKEN_TTL_DAYS=30

# --- Steam 上游 ---
GC_STEAM_API_BASE=https://api.steampowered.com
GC_STEAM_STORE_BASE=https://store.steampowered.com
GC_STEAM_COMMUNITY_BASE=https://steamcommunity.com
GC_STEAM_CDN_BASE=https://cdn.cloudflare.steamstatic.com/steam/apps
GC_STEAM_REQUEST_TIMEOUT=10
GC_STEAM_MAX_RETRIES=4
# node-steam-user 登录侧车地址（sidecar/，本地）
GC_STEAM_SIDECAR_URL=http://127.0.0.1:8765
# 启动时是否自动用浏览器打开登录页
GC_AUTO_OPEN_LOGIN=false
# OpenID（Layer 1）的 return_to / realm 基址，必须是浏览器能访问到的绝对地址
GC_PUBLIC_BASE_URL=http://127.0.0.1:8000
# 登录成功 / 失败后跳回的前端地址（回落值）：回调 302 回该地址，token 放 URL fragment（#token=...）。
# 前端发起登录时会用 ?front=<自己的源> 报上来，白名单（GC_CORS_ORIGINS）内的源优先于这个值；
# 所以后端托管（8000）和 serve.py（5173）两种起法都能正确回跳，这里只是兜底。
# 留空 = 回调直接返回 JSON（curl / 非浏览器客户端调试用）。
GC_FRONTEND_BASE_URL=http://localhost:5173

# --- 前端托管 ---
# 后端直接托管 timeline/ 目录：打开 http://127.0.0.1:8000/ 即是应用，不用另起静态服务器。
GC_SERVE_FRONTEND=true
# 前端目录；留空 = 仓库里的 timeline/。
# GC_FRONTEND_DIR=
# 截图 / 购买历史单次同步最多拉的页数（防膨胀）
GC_SCREENSHOT_MAX_PAGES=3
GC_PURCHASE_HISTORY_MAX_PAGES=10
# 成就回填单轮处理的游戏数上限（增量 + 分批）。
# 每个游戏要打 2~3 次上游接口；调大会加快首次回填，也更容易撞限流。
GC_ACHIEVEMENT_BATCH_SIZE=50

# 仅开发用：Steam 校验不可用时是否信任客户端自报 steamid（生产必须为 false）。
GC_AUTH_TRUST_CLIENT_STEAMID=false

# --- 启动行为 ---
# 启动时自动建表（SQLite 开发便利；生产建议走 Alembic 迁移并设为 false）。
GC_AUTO_CREATE_TABLES=true
# 是否启用每日采集定时任务。
GC_SCHEDULER_ENABLED=true
# 每日采集触发时间（UTC）。
GC_DAILY_SYNC_HOUR=3
GC_DAILY_SYNC_MINUTE=0

# --- 限流（最低程度，防滥用） ---
GC_RATE_LIMIT_DEFAULT=300/minute
GC_RATE_LIMIT_AUTH=30/minute

# --- CORS ---
# 默认放行本机前端（timeline/ 默认跑 5173）。
# ⚠️ 前端不要用 8080：Steam 客户端的 CEF 远程调试固定占用 8080
# （steamwebhelper.exe --remote-debugging-port=8080），本项目用户必然开着 Steam，撞端口是必然。
# 生产必须显式列出前端站点；`["*"]` 仅限临时调试，不要留在部署配置里。
GC_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
